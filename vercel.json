{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{frontend/**,tests/**,outputs/**,**/__pycache__/**,**/.pytest_cache/**,.venv/**,ML/data/**,ML/artifacts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
